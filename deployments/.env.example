# Copy this file to deployments/.env before running Docker Compose.
# Generate each value independently; never reuse development secrets in production.
#
# PowerShell:
#   $bytes = New-Object byte[] 32; [Security.Cryptography.RandomNumberGenerator]::Fill($bytes); [Convert]::ToHexString($bytes).ToLower() # PostgreSQL password
#   $bytes = New-Object byte[] 32; [Security.Cryptography.RandomNumberGenerator]::Fill($bytes); [Convert]::ToHexString($bytes).ToLower() # setup token
#   $bytes = New-Object byte[] 32; [Security.Cryptography.RandomNumberGenerator]::Fill($bytes); [Convert]::ToBase64String($bytes)          # token secret
#   $bytes = New-Object byte[] 32; [Security.Cryptography.RandomNumberGenerator]::Fill($bytes); [Convert]::ToHexString($bytes).ToLower() # optional metrics token
#
# POSIX shell:
#   openssl rand -hex 32                                 # PostgreSQL password
#   openssl rand -hex 32                                 # setup token
#   openssl rand -base64 32                              # token secret
#   openssl rand -hex 32                                 # optional metrics bearer token

PGBASE_POSTGRES_PASSWORD=
PGBASE_SETUP_TOKEN=
PGBASE_TOKEN_SECRET=

# Optional. When set, enables the bearer-protected GET /metrics endpoint.
PGBASE_METRICS_TOKEN=

# Optional local bindings and development image metadata.
PGBASE_HTTP_PORT=8090
PGBASE_POSTGRES_PORT=5432
PGBASE_PUBLIC_URL=http://127.0.0.1:8090
PGBASE_VERSION=dev
PGBASE_IMAGE=pgbase:dev
PGBASE_STATEMENT_TIMEOUT=5s
PGBASE_SCHEMA_APPLY_TIMEOUT=10m
PGBASE_SHUTDOWN_TIMEOUT=15s
PGBASE_STOP_GRACE_PERIOD=20s

# Conservative runtime ceilings for the bundled development Compose profile.
# These are safety bounds, not production capacity recommendations.
PGBASE_APP_CPUS=2.0
PGBASE_APP_MEMORY_LIMIT=1g
PGBASE_APP_PIDS_LIMIT=256
PGBASE_POSTGRES_CPUS=2.0
PGBASE_POSTGRES_MEMORY_LIMIT=1g
PGBASE_POSTGRES_PIDS_LIMIT=256
