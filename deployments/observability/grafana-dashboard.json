        "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
        "definition": "label_values(pgbase_http_requests_total, job)",
        "includeAll": true,
        "label": "Job",
        "multi": true,
        "name": "job",
        "query": { "query": "label_values(pgbase_http_requests_total, job)", "refId": "StandardVariableQuery" },
        "refresh": 1,
        "type": "query"
      },
      {
        "allValue": ".*",
        "current": {},
        "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
        "definition": "label_values(pgbase_http_requests_total{job=~\"$job\"}, instance)",
        "includeAll": true,
        "label": "Instance",
        "multi": true,
        "name": "instance",
        "query": { "query": "label_values(pgbase_http_requests_total{job=~\"$job\"}, instance)", "refId": "StandardVariableQuery" },
        "refresh": 1,
        "type": "query"
      }
    ]
  },
  "time": { "from": "now-6h", "to": "now" },
  "timezone": "browser",
  "title": "pgBase operational telemetry",
