# Paste into Dokploy's Environment tab; generate each secret independently.
# Use hex for the database password so it is safe inside the database URL.
PGBASE_POSTGRES_PASSWORD=
PGBASE_SETUP_TOKEN=
PGBASE_TOKEN_SECRET=
PGBASE_RUNTIME_SETTINGS_ENCRYPTION_KEY=
PGBASE_PUBLIC_URL=https://pgbase.example.com
# docker network inspect dokploy-network --format '{{range .IPAM.Config}}{{println .Subnet}}{{end}}'
# Replace with the actual CIDR(s), comma-separated. Never use 0.0.0.0/0.
PGBASE_TRUSTED_PROXIES=
